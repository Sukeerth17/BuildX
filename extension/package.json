{
  "name": "complianceai",
  "displayName": "ComplianceAI",
  "version": "0.0.1",
  "publisher": "hackathon",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:yaml",
    "onLanguage:terraform"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "complianceai.scan",
        "title": "ComplianceAI: Run Scan"
      },
      {
        "command": "complianceai.clearDiagnostics",
        "title": "ComplianceAI: Clear Diagnostics"
      }
    ],
    "configuration": {
      "title": "ComplianceAI",
      "properties": {
        "complianceai.jwtToken": {
          "type": "string",
          "description": "JWT Token"
        },
        "complianceai.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend URL"
        },
        "complianceai.enableAutoScan": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto scan"
        },
        "complianceai.severityThreshold": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
          "default": "MEDIUM"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "complianceai-sidebar",
          "title": "ComplianceAI",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "complianceai-sidebar": [
        {
          "id": "complianceai.sidebar",
          "name": "ComplianceAI Sidebar"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
